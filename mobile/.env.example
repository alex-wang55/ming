# Copy to .env.local. Same Supabase project and anon key as the web app.
# EXPO_PUBLIC_ values are bundled into the app, so never put server keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The deployed web app, which doubles as this app's API.
EXPO_PUBLIC_API_URL=https://ming-wine.vercel.app

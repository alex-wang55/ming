# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.

# Chat: set ONE of these (Anthropic is used if both are set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voice input uses OpenAI Whisper, so OPENAI_API_KEY is also needed for the mic.

# Pronunciation audio
GOOGLE_TTS_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_KEY=
